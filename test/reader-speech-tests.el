         (my-read-set-speech-language 'en)
         (should (equal my/read-source-language "en"))
         (should (string-match-p "EN/Kokoro" header-line-format))
         (my-read-k--apply-page
          '((text . "次のページ。") (language . "ja") (fingerprint . "4")) 'next nil)
         (should (eq kokoro-reader-backend 'kokoro))
         (should (equal my/read-source-language "en"))
         (my-read-use-auto-speech)
         (should (equal my/read-source-language "ja"))
         (should (eq kokoro-reader-backend 'macos)))))))

(ert-deftest my-read-k-speech-language-requires-active-center ()
  (with-temp-buffer
    (my-read-k-document-mode)
    (cl-letf (((symbol-function 'my/read--center-window-active-p) (lambda () nil)))
      (should-error (my-read-set-speech-language 'ja) :type 'user-error)
      (should-not my/read-speech-language-override))))

(provide 'reader-speech-tests)

(ert-deftest my-read-change-speed-selects-current-language ()
  (dolist (language '("en" "ja"))
    (with-temp-buffer
      (setq-local my/read-source-language language)
      (let ((my/read-japanese-speech-backend 'macos)
            (kokoro-reader-backend 'kokoro)
            changed)
        (cl-letf (((symbol-function 'read-number) (lambda (&rest _) (if (equal language "en") 1.2 400)))
                  ((symbol-function 'my/read--change-language-speed)
                   (lambda (lang rate &optional backend) (setq changed (list lang rate backend)))))
          (call-interactively #'my-read-change-speed)
          (should (equal changed (if (equal language "en") '("en" 1.2 t) '("ja" 400 nil)))))))))

(ert-deftest my-read-change-speed-is-only-interactive-speed-command ()
  (should (commandp 'my-read-change-speed))
  (should-not (commandp 'my-read-change-english-speed))
  (should-not (commandp 'my-read-change-japanese-speed)))
