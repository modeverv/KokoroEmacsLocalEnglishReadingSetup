;;; reader-speech-tests.el --- Speech regressions -*- lexical-binding: t; -*-

(require 'reader-test-helpers)

(ert-deftest my-read-japanese-epub-uses-macos-japanese-speech ()
  (with-temp-buffer
    (insert "あの日、わたしとあいつとの関係が壊れた。")
    (my/read--configure-speech-language)
    (should (equal my/read-source-language "ja"))
    (should (eq kokoro-reader-backend 'macos))
    (should (equal kokoro-reader-macos-voice
                   my/read-japanese-macos-voice))
    (should (= kokoro-reader-macos-rate 540))
    (should (= kokoro-reader-macos-rate
               (* 3 (default-value 'kokoro-reader-macos-rate))))))

(ert-deftest my-read-english-epub-clears-japanese-speech-overrides ()
  (with-temp-buffer
    (setq-local kokoro-reader-backend 'macos)
    (setq-local kokoro-reader-macos-voice "Kyoko (Enhanced)")
    (setq-local kokoro-reader-macos-rate 540)
    (insert "This is an English sentence.")
    (my/read--configure-speech-language)
    (should (equal my/read-source-language "en"))
    (should (eq kokoro-reader-backend 'kokoro))
    (should (equal kokoro-reader-macos-voice "Samantha"))
    (should-not (local-variable-p 'kokoro-reader-backend))
    (should-not (local-variable-p 'kokoro-reader-macos-voice))
    (should (= kokoro-reader-macos-rate my/read-english-macos-rate))))

(ert-deftest my-read-language-speeds-are-independent-and-survive-switching ()
  (let ((kokoro-reader-backend 'macos)
        (my/read-japanese-macos-rate 540)
        (my/read-english-macos-rate 180)
        (english-reading-mode--continuous-state nil)
        (kokoro-reader--overlay nil)
        (ja (generate-new-buffer " *speed-ja*"))
        (en (generate-new-buffer " *speed-en*"))
        (stops 0))
    (unwind-protect
        (cl-letf (((symbol-function 'english-reading-mode-stop-continuous)
                   (lambda (&optional _quiet) (cl-incf stops))))
          (with-current-buffer ja (my/read--configure-speech-language "ja"))
          (with-current-buffer en (my/read--configure-speech-language "en"))
          ;; Warmup may be active before any speech overlay exists.
          (setq english-reading-mode--continuous-state (list :buffer ja))
          (my-read-change-english-speed 240)
          (should (= stops 0))
          (should (= my/read-japanese-macos-rate 540))
          (should (= (buffer-local-value 'kokoro-reader-macos-rate ja) 540))
          (should (= (buffer-local-value 'kokoro-reader-macos-rate en) 240))
          (my-read-change-japanese-speed 420)
          (should (= stops 1))
          (should (= my/read-english-macos-rate 240))
          (should (= (buffer-local-value 'kokoro-reader-macos-rate ja) 420))
          (setq english-reading-mode--continuous-state (list :buffer en))
          (my-read-change-english-speed 260)
          (should (= stops 2))
          (with-current-buffer en
            (my/read--configure-speech-language "ja")
            (should (= kokoro-reader-macos-rate 420))
            (my/read--configure-speech-language "en")
            (should (= kokoro-reader-macos-rate 260))))
      (kill-buffer ja)
      (kill-buffer en))))

(ert-deftest my-read-language-speeds-reject-invalid-input-before-changing-state ()
  (let ((kokoro-reader-backend 'macos)
        (my/read-japanese-macos-rate 540)
        (my/read-english-macos-rate 180))
    (dolist (command '(my-read-change-japanese-speed my-read-change-english-speed))
      (dolist (rate '(0 -1 1.5 "200" nil))
        (should-error (funcall command rate) :type 'user-error)))
    (should (= my/read-japanese-macos-rate 540))
    (should (= my/read-english-macos-rate 180))))

(ert-deftest my-read-english-kokoro-speed-preserves-japanese-speed ()
  (let ((kokoro-reader-backend 'kokoro)
        (kokoro-reader-speed 1.0)
        (my/read-japanese-macos-rate 250)
        (english-reading-mode--continuous-state nil)
        (kokoro-reader--overlay nil))
    (with-temp-buffer
      (my/read--configure-speech-language "en")
      (my-read-change-english-speed 1.25)
      (should (= kokoro-reader-speed 1.25))
      (should (= (default-value 'kokoro-reader-speed) 1.25))
      (should (= my/read-japanese-macos-rate 250))
      (dolist (rate '(0 0.4 2.1 180 "1.0"))
        (should-error (my-read-change-english-speed rate) :type 'user-error))
      (should (= kokoro-reader-speed 1.25)))))

(ert-deftest my-read-english-backend-selection-preserves-japanese ()
  (let ((kokoro-reader-backend 'kokoro)
        (my/read-japanese-speech-backend 'irodori)
        (english-reading-mode--continuous-state nil)
        (kokoro-reader--overlay nil))
    (with-temp-buffer
      (my/read--configure-speech-language "ja")
      (let ((japanese-buffer (current-buffer)))
        (with-temp-buffer
          (setq-local my/read-speech-language-override 'en)
          (my/read--configure-speech-language)
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (_prompt candidates &rest _args)
                       (should (equal candidates '("kokoro" "macos")))
                       "macos")))
            (call-interactively #'my-read-set-english-speech-backend))
          (should (eq kokoro-reader-backend 'macos))
          (my/read--configure-speech-language)
          (should (eq kokoro-reader-backend 'macos))
          (with-temp-buffer
            (my/read--configure-speech-language "en")
            (should (eq kokoro-reader-backend 'macos)))
          (with-current-buffer japanese-buffer
            (should (eq kokoro-reader-backend 'irodori))
            (should (equal kokoro-reader-model "irodori-tts")))
          (my-read-set-english-speech-backend 'kokoro)
          (should (eq kokoro-reader-backend 'kokoro))
          (should-error (my-read-set-english-speech-backend 'irodori)
                        :type 'user-error)
          (should (eq kokoro-reader-backend 'kokoro)))))))

(ert-deftest my-read-japanese-kokoro-switching-keeps-english-settings ()
  (let ((my/read-japanese-speech-backend 'macos)
        (my/read-japanese-kokoro-voice "jf_alpha")
        (my/read-japanese-kokoro-speed 1.0)
        (my/read-japanese-macos-rate 250)
        (kokoro-reader-backend 'kokoro)
        (kokoro-reader-voice "bf_emma")
        (kokoro-reader-lang-code "b")
        (kokoro-reader-speed 1.2)
        (english-reading-mode--continuous-state nil)
        (kokoro-reader--overlay nil))
    (with-temp-buffer
      (my/read--configure-speech-language "ja")
      (my-read-set-japanese-speech-backend 'kokoro)
      (should (eq kokoro-reader-backend 'kokoro))
      (should (equal kokoro-reader-voice "jf_alpha"))
      (should (equal kokoro-reader-lang-code "j"))
      (my-read-change-japanese-speed 1.1)
      (should (= kokoro-reader-speed 1.1))
      (should (= my/read-japanese-kokoro-speed 1.1))
      (should (= (default-value 'kokoro-reader-speed) 1.2))
      (should (= my/read-japanese-macos-rate 250))
      (my-read-change-english-speed 1.4)
      (should (= kokoro-reader-speed 1.1))
      (should (= (default-value 'kokoro-reader-speed) 1.4))
      (should-error (my-read-change-japanese-speed 250) :type 'user-error)
      (my/read--configure-speech-language "en")
      (should (equal kokoro-reader-voice "bf_emma"))
      (should (equal kokoro-reader-lang-code "b"))
      (should (= kokoro-reader-speed 1.4))
      (my/read--configure-speech-language "ja")
      (should (= kokoro-reader-speed 1.1))
      (my-read-set-japanese-speech-backend 'macos)
      (should (eq kokoro-reader-backend 'macos))
      (should (= kokoro-reader-macos-rate 250))
      (should-error (my-read-set-japanese-speech-backend 'invalid)
                    :type 'user-error))))

(ert-deftest my-read-irodori-filters-quotes-before-sending-and-prefetching ()
  (let ((kokoro-reader-backend 'irodori)
        (kokoro-reader--macos-prefetch-queue nil)
        (kokoro-reader--macos-current-entry nil)
        (kokoro-reader-kokoro-prefetch-count 2)
        queued)
    (should (equal (gethash "input" (json-parse-string
                                    (kokoro-reader--payload "「本文です。」」")))
                   "「本文です。"))
    (should (equal (kokoro-reader--kokoro-key "本文です。」")
                   (kokoro-reader--kokoro-key "本文です。")))
    (cl-letf (((symbol-function 'kokoro-reader--enqueue-kokoro-text)
               (lambda (text &optional _) (push text queued))))
      (kokoro-reader-prefetch-kokoro-texts '("」" "本文です。」" "次です。」")))
    (should (equal (nreverse queued) '("本文です。" "次です。")))
    (dolist (backend '(kokoro macos))
      (let ((kokoro-reader-backend backend))
        (should (equal (kokoro-reader--speech-text "本文です。」") "本文です。」"))))))

(ert-deftest my-read-irodori-empty-quote-advances-without-audio-or-wait ()
  (with-temp-buffer
    (insert "」")
    (let ((kokoro-reader-backend 'irodori)
          (kokoro-reader--macos-current-entry nil)
          (english-reading-mode t)
          (english-reading-mode--active-speech nil)
          (english-reading-mode--speech-watch-timer nil)
          (english-reading-mode--continuous-timer nil)
          (english-reading-mode--continuous-state (list :buffer (current-buffer)))
          (english-reading-mode-speech-finish-hook
           '(english-reading-mode--continuous-speech-finished))
          scheduled)
      (cl-letf (((symbol-function 'kokoro-reader--enqueue-kokoro-text)
                 (lambda (&rest _) (ert-fail "Empty text was sent")))
                ((symbol-function 'kokoro-reader-stop)
                 (lambda (&rest _) (ert-fail "Prefetch was cancelled")))
                ((symbol-function 'english-reading-mode--start-watch)
                 (lambda (&rest _) (ert-fail "Waiting for nonexistent audio")))
                ((symbol-function 'kokoro-reader-macos-has-pending-p)
                 (lambda () t))
                ((symbol-function 'run-at-time)
                 (lambda (delay _repeat callback &rest _)
                   (setq scheduled (list delay callback)))))
        (kokoro-reader--speak-bounds (point-min) (point-max)))
      (should (zerop (car scheduled)))
      (let (advanced)
        (cl-letf (((symbol-function 'english-reading-mode--continuous-next)
                   (lambda () (setq advanced t))))
          (funcall (cadr scheduled)))
        (should advanced))
      (should (= (plist-get english-reading-mode--continuous-state
                            :next-speech-position) (point-max)))
      (should-not english-reading-mode--active-speech)
      (should (equal (buffer-string) "」")))))

(ert-deftest my-read-kyoko-filters-bridge-input-and-prefetch-keys ()
  (let ((kokoro-reader-backend 'macos)
        (kokoro-reader-macos-voice "Kyoko (Enhanced)")
        (kokoro-reader-macos-prefetch-enabled t)
        (kokoro-reader-macos-prefetch-count 2)
        (kokoro-reader--macos-prefetch-queue nil)
        (kokoro-reader--macos-current-entry nil)
        (kokoro-reader--macos-next-id 0)
        sent)
    (cl-letf (((symbol-function 'kokoro-reader--ensure-macos-bridge)
               (lambda () 'bridge))
              ((symbol-function 'process-send-string)
               (lambda (_process text)
                 (push (gethash "text" (json-parse-string text)) sent))))
      (kokoro-reader-prefetch-macos-texts '("」）" "「本文です。）」」" "次です。）」"))
      (should (equal (reverse sent) '("本文です。" "次です。")))
      (should (kokoro-reader-macos-prefetch-ready-p "「本文です。）」」"))
      (kokoro-reader-prefetch-macos-texts '("「本文です。）」」" "次です。）」"))
      (should (= (length sent) 2)))
    (should (equal (kokoro-reader--speech-text "」\n\n「知りたいからよ」")
                   "知りたいからよ"))
    (should (equal (kokoro-reader--macos-key "」\n\n「知りたいからよ」")
                   (kokoro-reader--macos-key "知りたいからよ")))
    (should (equal (kokoro-reader--speech-text "　」\n\n「　") ""))
    (dolist (voice '("Kyoko" "Kyoko (Enhanced)"))
      (let ((kokoro-reader-macos-voice voice))
        (should (equal (kokoro-reader--speech-text "本文です。）」") "本文です。"))))
    (let ((kokoro-reader-macos-voice "Samantha"))
      (should (equal (kokoro-reader--speech-text "本文です。）」") "本文です。）」")))))

