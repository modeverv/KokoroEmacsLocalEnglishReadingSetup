(ert-deftest my-read-irodori-reference-profile-and-speed-stay-japanese ()
  (let ((my/read-japanese-speech-backend 'macos)
        (my/read-japanese-irodori-speed 1.0)
        (my/read-japanese-kokoro-speed 1.1)
        (kokoro-reader-backend 'kokoro)
        (kokoro-reader-model "mlx-community/Kokoro-82M-bf16")
        (kokoro-reader-voice "bf_emma")
        (kokoro-reader-speed 1.2)
        (english-reading-mode--continuous-state nil)
        (kokoro-reader--overlay nil))
    (with-temp-buffer
      (my/read--configure-speech-language "ja")
      (my-read-set-japanese-speech-backend 'irodori)
      (should (eq kokoro-reader-backend 'irodori))
      (let ((payload (json-parse-string (kokoro-reader--payload "日本語です。"))))
        (should (equal (gethash "model" payload) "irodori-tts"))
        (should (equal (gethash "voice" payload) "asuka")))
      (my-read-change-japanese-speed 1.3)
      (should (= kokoro-reader-speed 1.3))
      (should (= my/read-japanese-irodori-speed 1.3))
      (should (= my/read-japanese-kokoro-speed 1.1))
      (should (= (default-value 'kokoro-reader-speed) 1.2))
      (my/read--configure-speech-language "en")
      (should (equal kokoro-reader-model "mlx-community/Kokoro-82M-bf16"))
      (should (equal kokoro-reader-voice "bf_emma"))
      (should (= kokoro-reader-speed 1.2))
      (my/read--configure-speech-language "ja")
      (my-read-set-japanese-speech-backend 'kokoro)
      (should-not (equal kokoro-reader-model "irodori-tts"))
      (should (= kokoro-reader-speed 1.1))
      (my-read-set-japanese-speech-backend 'macos)
      (should (eq kokoro-reader-backend 'macos)))))

